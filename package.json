{
  "name": "printags",
  "version": "0.1.1",
  "description": "SDK and command line for the Printags API: price, order and track printed PVC, NFC and wooden cards.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "bin": {
    "printags": "bin/printags.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "printags",
    "cards",
    "pvc",
    "nfc",
    "printing",
    "api",
    "sdk",
    "cli"
  ],
  "homepage": "https://www.printags.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/printags/printags-js.git"
  },
  "bugs": {
    "url": "https://github.com/printags/printags-js/issues"
  },
  "author": "Printags <contact@printags.com> (https://www.printags.com)",
  "license": "MIT"
}
